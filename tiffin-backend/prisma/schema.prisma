// Tiffin backend — database schema.
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env to
// create these tables in your Postgres database, then `npm run seed` to
// load mock vendors/products matching what the frontend already expects
// (same ids as VENDORS/PRODUCTS in tiffin-app.html, so swapping the
// frontend's mock Services.Catalog for real fetch() calls needs no id
// remapping).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// AUTH + CUSTOMER (Stage 2)
// ---------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Stage 9 (brief §25): lets the customer opt out of PROMOTIONAL pushes
  // only — order/payment/refund updates are transactional and always
  // sent regardless of this flag. Checked in notificationService.notify()
  // for type 'promo' / 'flash_offer'. Default false = promos on by
  // default, matching most delivery apps' opt-out (not opt-in) pattern.
  promoOptOut Boolean  @default(false)

  addresses   Address[]
  orders      Order[]
  favorites   Favorite[]
  reviews     Review[]
  tickets     SupportTicket[]
  otps        OtpCode[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
}

// Stage 10 (brief §37/security): a customer's registered push-notification
// endpoint(s) — one row per device/browser they've logged in on. A real
// push send (see notificationService.js) fans out to every token here for
// the customer, and prunes rows FCM reports as no-longer-registered so
// this table doesn't silently accumulate dead tokens forever.
model DeviceToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   // 'android' | 'ios' | 'web'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// OTP codes are stored hashed-in-spirit (short-lived, single use) — never
// treat this table as a place to keep long-term secrets.
model OtpCode {
  id          String   @id @default(cuid())
  phone       String
  code        String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([phone])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   // "Home" | "Work" | "Other"
  name       String
  phone      String
  address    String
  landmark   String?
  area       String?
  city       String
  pin        String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]
}

// ---------------------------------------------------------------------
// CATALOG (Stage 3) — multi-vendor: restaurants (food) and stores (grocery)
// ---------------------------------------------------------------------

enum VendorMode {
  food
  grocery
}

model Vendor {
  id          String     @id @default(cuid())
  mode        VendorMode
  name        String
  emoji       String?
  tags        String[]   // cuisine tags (food) or category tags (grocery)
  rating      Float      @default(4.5)
  distanceKm  Float      @default(1.0) // MOCK — replace with real geo distance from customer at query time
  etaMin      Int        @default(20)
  etaMax      Int        @default(30)
  isOpen      Boolean    @default(true)
  offer       String?
  lat         Float?
  lng         Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]
  orders      Order[]
  favorites   Favorite[]
  reviews     Review[]
  flashOffers FlashOffer[]
  staff       VendorStaff[]
}

// ---------------------------------------------------------------------
// VENDOR / RIDER ACCOUNTS (Stage 10, brief §37 security pass) — the real
// replacement for the old shared ADMIN_API_KEY (see routes/admin.js and
// routes/staffAuth.js). ADMIN_API_KEY is kept only as a narrow "platform
// ops" door for provisioning these accounts, never for day-to-day
// order/stock/refund actions anymore.
// ---------------------------------------------------------------------

// One row per restaurant/store staff login. Scoped to a single vendor —
// a VendorStaff can only ever act on their own vendor's orders, products,
// and flash offers (enforced in routes/admin.js, not just by convention).
model VendorStaff {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  phone        String   @unique
  name         String
  passwordHash String
  role         String   @default("staff") // 'staff' | 'owner' — both currently carry the same permissions; kept distinct for a future finer-grained split
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per rider login. Not tied to a vendor — a rider can be assigned
// deliveries across vendors, matching how delivery fleets actually work.
model Rider {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  passwordHash String
  vehicle      String?
  plate        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
}

enum StockStatus {
  in
  low
  out
}

model Product {
  id         String      @id @default(cuid())
  vendorId   String
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  mode       VendorMode
  category   String
  name       String
  price      Float
  emoji      String?
  offLabel   String?     // e.g. "20% off" — display only, not authoritative pricing
  desc       String?
  stock      StockStatus @default(in)
  addons     Json?       // [{ name, price }]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  orderItems OrderItem[]
  favorites  Favorite[]
}

model Favorite {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([customerId, vendorId, productId])
}

// ---------------------------------------------------------------------
// DELIVERY PRICING (Stage 4) — configurable distance slabs, not hardcoded
// ---------------------------------------------------------------------

model DeliverySlab {
  id        Int    @id @default(autoincrement())
  maxKm     Float  // this slab applies when distance <= maxKm (highest maxKm = "and above")
  fee       Float
  sortOrder Int    @default(0)
}

// ---------------------------------------------------------------------
// COUPONS (Stage 4)
// ---------------------------------------------------------------------

enum CouponType {
  percent
  flat
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Float
  minOrder      Float      @default(0)
  maxDiscount   Float
  mode          VendorMode
  desc          String?
  expiresAt     DateTime?
  usageLimit    Int?       // total uses allowed across all customers
  perUserLimit  Int        @default(1)
  isActive      Boolean    @default(true)

  orders        Order[]
}

// ---------------------------------------------------------------------
// ORDERS (Stage 6) + PAYMENTS (Stage 5) + REFUNDS/SUPPORT (Stage 8)
// ---------------------------------------------------------------------

enum Fulfilment {
  delivery
  pickup
}

enum PaymentMethod {
  upi
  card
  netbanking
  cod
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partially_refunded
}

// Deliberately a plain string, not an enum: it must hold the EXACT status
// labels used in `statusChain` below (brief §13's own wording, e.g.
// "ORDER PLACED", "RESTAURANT ACCEPTED"), which differ by vendor mode,
// fulfilment type, and scheduled-vs-instant — an enum can't express
// spaces or that variability cleanly. `cancelled` is its own boolean
// rather than a status value, exactly like the frontend's order model.

model Order {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  addressId      String?
  address        Address?      @relation(fields: [addressId], references: [id])

  fulfilment     Fulfilment    @default(delivery)
  deliveryType   String?       // 'instant' | 'scheduled' (grocery only)
  scheduleDate   String?
  scheduleSlot   String?

  subtotal       Float
  discount       Float         @default(0)
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  deliveryFee    Float         @default(0)
  tax            Float         @default(0)
  total          Float

  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(pending)
  paymentId      String?

  status         String        @default("ORDER PLACED")
  statusChain    String[]      // the exact ordered chain this order runs, e.g. brief §13
  statusIndex    Int           @default(0)

  // riderId links to the real, authenticated Rider account assigned to
  // this order (Stage 10) — the riderName/Phone/Vehicle/Plate fields below
  // are kept as a point-in-time snapshot (so an order's delivery-partner
  // record on receipts/support doesn't change retroactively if the rider
  // later edits their profile), but riderId is what actually gates who
  // may advance this order past RIDER ASSIGNED (see routes/admin.js).
  riderId        String?
  rider          Rider?        @relation(fields: [riderId], references: [id])
  riderName      String?
  riderPhone     String?
  riderVehicle   String?
  riderPlate     String?
  pickupCode     String?

  cancelled      Boolean       @default(false)
  cancelReason   String?
  cancelCharge   Float         @default(0)

  placedAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          OrderItem[]
  payment        Payment?
  refund         Refund?
  review         Review?
  supportTickets SupportTicket[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Float
  qty       Int
  addons    Json?    // [{ name, price }] snapshot at order time
  note      String?
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayRef    String?       // id returned by the real payment gateway
  method        PaymentMethod
  amount        Float
  status        PaymentStatus @default(pending)
  rawWebhook    Json?         // last raw webhook payload received, for audit/debug
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum RefundStatus {
  requested
  under_review
  approved
  rejected
  processing
  completed
}

model Refund {
  id         String       @id @default(cuid())
  orderId    String       @unique
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Float
  reason     String
  status     RefundStatus @default(requested)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

model SupportTicket {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id])
  category   String       // e.g. 'refund' | 'missing_item' | 'late_delivery' | 'payment' | 'cancellation' | 'other'
  message    String
  status     TicketStatus @default(open)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// ---------------------------------------------------------------------
// FLASH OFFERS (Stage 9)
// ---------------------------------------------------------------------

model FlashOffer {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  itemName      String
  originalPrice Float
  offerPrice    Float
  quantity      Int
  startsAt      DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------
// NOTIFICATIONS (Stage 9) — in-app notification feed.
// Real push (FCM/APNs, Stage 10) is layered on top of this table, not a
// replacement for it: notificationService.notify() always writes a row
// here first, then also sends a real push (fanning out to DeviceToken
// below) when PUSH_PROVIDER is configured — see
// src/services/notificationService.js and src/lib/push/*.js.
// ---------------------------------------------------------------------

enum NotificationType {
  order_status
  payment
  refund
  promo
  flash_offer
}

model Notification {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  orderId    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
}
