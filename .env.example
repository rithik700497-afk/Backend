# Copy this file to .env and fill in real values before running.

# Postgres connection string. Free options to get one in minutes:
# Neon (neon.tech), Supabase (supabase.com), or Railway (railway.app).
DATABASE_URL="postgresql://user:password@host:5432/tiffin?schema=public"

# Any long random string — used to sign customer session JWTs.
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# A DIFFERENT long random string — used to sign vendor-staff/rider/
# superadmin session JWTs (Stage 10). Keep this separate from JWT_SECRET
# so a leaked customer secret can never forge an ops session, or vice
# versa. Falls back to JWT_SECRET if unset, but set both in production.
STAFF_JWT_SECRET="change-this-to-a-different-long-random-string"
STAFF_JWT_EXPIRES_IN="12h"

PORT=4000

# ---- OTP / SMS provider (Stage 2, live delivery added Stage 10) ----
# Leave OTP_PROVIDER unset to keep DEV MODE: OTPs are generated and
# returned directly in the API response (never sent by real SMS) so you
# can test the full flow with zero external accounts.
#
# Set to "twilio" or "msg91" to send real SMS — see src/services/otpService.js
# and src/lib/sms/*.js. Fill in the matching credentials below.
OTP_PROVIDER=

# -- Twilio (OTP_PROVIDER=twilio) --
# Preferred: use Twilio Verify (set TWILIO_VERIFY_SERVICE_SID) — Twilio
# generates and checks the code itself, so this app never stores one.
# Fallback: set TWILIO_FROM_NUMBER instead to send a plain SMS with a
# code this app generates and stores (same as dev mode, just really sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# -- MSG91 (OTP_PROVIDER=msg91) — common for Indian-number delivery --
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Payment gateway (Stage 5) ----
# Leave unset to keep DEV MODE: charge() is simulated locally (see
# src/services/paymentGatewayService.js), same ~88% success rate as the
# frontend mock, purely for exercising the failure path end to end.
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# Comma-separated list of origins allowed to call this API (your deployed
# frontend's URL, plus http://localhost for local testing).
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---- Superadmin / platform-ops access (Stage 9, narrowed in Stage 10) ----
# Restaurant/store/rider-side actions (accepting orders, advancing
# status, updating stock, flash offers, resolving refunds/support
# tickets) are now gated by real vendor-staff and rider accounts — see
# POST /staff/auth/vendor-login and /staff/auth/rider-login, and
# src/middleware/requireStaff.js. ADMIN_API_KEY now only does two things:
#   1. Provisions those accounts (POST /admin/vendor-staff, /admin/riders)
#   2. Mints a short-lived superadmin session via POST /staff/auth/superadmin,
#      a break-glass fallback that can act as any vendor.
# Generate a long random value and keep it offline/in a secrets manager —
# it is never sent on every request anymore, only once to mint a token.
ADMIN_API_KEY="change-this-to-a-long-random-string"

# ---- Push notifications (Stage 9, live delivery added Stage 10) ----
# Leave PUSH_PROVIDER unset to keep DEV MODE: notifications are recorded
# in the database (GET /notifications) but no real push is sent.
#
# Set to "fcm" (recommended — covers Android/iOS/web with one API) or
# "apns" (direct Apple push, iOS only) to send real pushes. See
# src/services/notificationService.js and src/lib/push/*.js.
PUSH_PROVIDER=

# -- Firebase Cloud Messaging (PUSH_PROVIDER=fcm) --
# The full service-account JSON from Firebase Console > Project Settings
# > Service Accounts > Generate new private key. Paste it as raw JSON
# (single line) or base64-encode it first if your host's env var input
# doesn't handle multi-line/quoted JSON well.
FCM_SERVICE_ACCOUNT_JSON=

# -- Direct APNs (PUSH_PROVIDER=apns) — requires `npm install apn` --
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_P8_BASE64=
APNS_PRODUCTION=false
